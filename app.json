{
  "expo": {
    "name": "hents-hurga-mobile",
    "slug": "hents-hurga-mobile",
    "scheme": "hentshurga",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "mn.hentshurga.mobile"
    },
    "android": {
      "package": "mn.hentshurga.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      [
        "expo-notifications",
        {
          "color": "#6E5B3E",
          "defaultChannel": "livestock-alerts"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
