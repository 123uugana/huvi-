ACCESS_TOKEN_SECRET=replace-with-a-long-random-secret
SMS_PROVIDER=log
EXPOSE_OTP=true

# DEV-ONLY: deterministic OTP code for local testing. It is only honored when
# EXPOSE_OTP=true and is ignored in production. Never set it in deployed envs.
OTP_CODE=123456

# Required only when SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
